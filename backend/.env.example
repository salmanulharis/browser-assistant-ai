# Copy to backend/.env and adjust. Never commit the real .env.
# The backend always binds to loopback; only 127.0.0.1 / localhost / ::1 are accepted.
LBA_HOST=127.0.0.1
LBA_PORT=8765

# Exact extension origin(s), comma separated. scripts\build.ps1 fills this in
# automatically from the pinned extension ID. Wildcards are rejected.
LBA_ALLOWED_ORIGINS=chrome-extension://<your-extension-id>

# Initial Ollama endpoint (Settings → AI overrides it once saved).
LBA_OLLAMA_URL=http://127.0.0.1:11434

# Where the database, vectors, uploads, backups and logs are stored.
# Default: %LOCALAPPDATA%\LocalBrowserAI
# LBA_DATA_DIR=C:\Users\you\AppData\Local\LocalBrowserAI

LBA_MAX_UPLOAD_MB=50
# Allow the extension to fetch the token from POST /api/v1/auth/pair (origin-checked).
LBA_ALLOW_PAIRING=true
LBA_LOG_LEVEL=INFO
